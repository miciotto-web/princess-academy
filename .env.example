# ============================================================
# PRINCESS ACADEMY — variabili d'ambiente
# Copiare in `.env.local` e compilare. MAI committare `.env.local`.
# Senza le variabili Supabase il sito usa i dati demo e l'admin
# mostra la guida alla configurazione.
# ============================================================

# --- Sito pubblico (canonical, sitemap, OG) ---
NEXT_PUBLIC_SITE_URL=https://www.princess-academy.it

# --- Supabase (dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Email transazionali (https://resend.com, opzionali) ---
# Senza queste, le prenotazioni funzionano comunque ma senza notifiche.
RESEND_API_KEY=re_...
EMAIL_FROM=Princess Academy <magia@princess-academy.it>
EMAIL_ADMIN=magia@princess-academy.it
